# Canonical site URL — used for sitemap, robots.txt, canonicals and JSON-LD.
# Must match the production domain exactly (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://princeachar.com

# Google Search Console verification token (the content value of the
# google-site-verification meta tag). Leave blank to omit the tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Tag Manager container. All analytics tags (GA4, Ads, pixels) live
# inside the container; the site only loads GTM.
NEXT_PUBLIC_GTM_ID=GTM-NXXBQ7LC
# GA4 measurement ID — configured as a tag inside the GTM container above,
# not loaded directly by the site.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-30ZQMK56KN

# Shopify (Storefront API)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=princeachar.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_token_here
NEXT_PUBLIC_SHOPIFY_API_VERSION=2024-10
# Shopify Customer Account API (new customer accounts) client ID
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your_customer_account_client_id_here

# Firebase (client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase (admin SDK — server-side only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=princeachar
# Server-side signing for authenticated admin uploads (/api/admin/upload)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
